{
  "name": "archive-system-frontend",
  "version": "1.0.0",
  "description": "Frontend application for Archive System",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write .",
    "showcase": "vite --mode showcase --host 127.0.0.1",
    "build:showcase": "npm run typecheck && vite build --mode showcase"
  },
  "keywords": [
    "archive",
    "system",
    "frontend",
    "typescript",
    "react"
  ],
  "author": "Archive System Team",
  "license": "MIT",
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^3.9.1",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "@mui/stylis-plugin-rtl": "^7.3.8",
    "@mui/x-data-grid": "^8.27.1",
    "@mui/x-date-pickers": "^8.27.2",
    "@mui/x-tree-view": "^8.27.2",
    "@tanstack/react-query": "^5.90.21",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^4.1.0",
    "jsdom": "^28.1.0",
    "lucide-react": "^0.563.0",
    "react": "^18.2.0",
    "react-date-object": "^2.1.9",
    "react-day-picker": "^9.11.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.53.2",
    "react-multi-date-picker": "^4.5.2",
    "react-router-dom": "^7.13.0",
    "react-window": "^2.2.6",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "stylis": "^4.4.0",
    "tailwind-merge": "^2.0.0",
    "tus-js-client": "^4.3.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^20.8.9",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@typescript-eslint/parser": "^6.8.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.52.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "postcss": "^8.4.31",
    "prettier": "^3.0.3",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
