{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "MinIO": {
    "Endpoint": "http://localhost:9000",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "archive-system"
  },
  "Storage": {
    "Provider": "MinIO"
  },
  "SqlFileStream": {
    "ContainerPath": "tenant/default/files"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "",
    "Password": ""
  },
  "Messaging": {
    "Enabled": false
  },
  "OcrWorker": {
    "PollIntervalSeconds": 15,
    "BatchSize": 50,
    "MaxConcurrentJobs": 2,
    "JobTimeoutMinutes": 10,
    "StaleProcessingTimeoutMinutes": 30,
    "StaleProcessingResetIntervalMinutes": 5
  },
  "RapidOcr": {
    "DetectionModelPath": "models/v5/ch_PP-OCRv5_mobile_det.onnx",
    "ClassificationModelPath": "models/v5/ch_PP-LCNet_x0_25_textline_ori_cls_mobile.onnx",
    "RecognitionModelPath": "models/persian-v5/rec.onnx",
    "DictionaryPath": "models/persian-v5/dict.txt",
    "ThreadCount": 4,
    "ImgResize": 1400,
    "TextScore": 0.5,
    "DoAngle": true,
    "PdfDpi": 200,
    "EnablePdfNativeTextExtraction": true,
    "PdfNativeTextMinimumCharacters": 40,
    "OcrPdfImagesWhenNativeTextExists": true,
    "PdfImageOcrMinimumCoverage": 0.08,
    "MaxInputBytes": 209715200,
    "TempDirectory": "",
    "EnableIdentityDocumentMode": true,
    "MinimumAcceptedConfidence": 0.35
  }
}
