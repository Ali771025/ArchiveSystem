{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "MinIO": {
    "Endpoint": "http://localhost:9000",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "archive-system"
  },
  "Storage": {
    "Provider": "MinIO"
  },
  "SqlFileStream": {
    "ContainerPath": "tenant/default/files"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "",
    "Password": ""
  },
  "Thumbnail": {
    "PollIntervalSeconds": 15,
    "BatchSize": 100,
    "MaxConcurrency": 4,
    "MaxDimension": 256,
    "OutputFormat": "jpeg",
    "JpegQuality": 75,
    "MaxRetryAttempts": 3,
    "RetryDelayMilliseconds": 250
  }
}
