{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "MinIO": {
    "Endpoint": "http://localhost:9000",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "archive-system"
  },
  "Storage": {
    "Provider": "MinIO"
  },
  "SqlFileStream": {
    "ContainerPath": "tenant/default/files"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "",
    "Password": ""
  },
  "ScannerIngest": {
    "Enabled": false,
    "WatchPath": "C:/archive-scanner/incoming",
    "ProcessedPath": "C:/archive-scanner/processed",
    "ErrorPath": "C:/archive-scanner/error",
    "PollIntervalSeconds": 10,
    "StableSeconds": 5,
    "AllowedExtensions": [
      ".pdf",
      ".png",
      ".jpg",
      ".jpeg",
      ".tif",
      ".tiff"
    ],
    "DefaultCaseId": null,
    "DefaultClassificationId": null
  }
}
