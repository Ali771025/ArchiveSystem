{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "BehsazConnection": "",
    "Redis": ""
  },
  "BehsazIntegration": {
    "IsEnabled": true,
    "UserCode": 13756,
    "ConnectionString": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "archive-portfolio",
    "Audience": "archive-portfolio",
    "ExpirationMinutes": 60,
    "IdleTimeoutMinutes": 20
  },
  "Migration": {
    "ApplyOnStartup": true,
    "MigrateOnly": false
  },
  "BootstrapAdmin": {
    "Enabled": false,
    "Email": "",
    "UserName": "",
    "Password": ""
  },
  "BootstrapRoles": {
    "FailOnError": false
  },
  "MinIO": {
    "Endpoint": "http://localhost:9000",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "archive-system",
    "Region": "us-east-1",
    "UseSSL": false,
    "ForcePathStyle": true
  },
  "Storage": {
    "Provider": "MinIO"
  },
  "SqlFileStream": {
    "ContainerPath": "tenant/default/files"
  },
  "OpenSearch": {
    "Uri": "http://localhost:9200",
    "IndexPrefix": "files"
  },
  "FileUpload": {
    "MaxFileSizeBytes": 104857600,
    "DefaultPartSizeBytes": 8388608,
    "MinPartSizeBytes": 5242880,
    "MaxPartSizeBytes": 67108864,
    "AllowedMimeTypes": [],
    "DefaultTenantId": "default",
    "RequestThumbnailProcessing": true,
    "RequestOcrProcessing": true
  },
  "Auditing": {
    "IgnoredFields": [
      "Password",
      "PasswordHash",
      "SecurityStamp",
      "ConcurrencyStamp",
      "RecoveryCodes"
    ]
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "",
    "Password": ""
  },
  "MeliPayamak": {
    "ApiKey": "",
    "SenderNumber": "",
    "LoginPatternCode": ""
  },
  "Integrations": {
    "MeliPayamak": {
      "BaseUrl": "",
      "PatternEndpoint": "api/SendSMS/BaseServiceNumber",
      "Username": "",
      "Password": "",
      "From": "",
      "LoginOtpPatternCode": "",
      "TimeoutSeconds": 10,
      "RetryCount": 3,
      "CircuitBreakDurationSeconds": 30,
      "CircuitBreakFailureThreshold": 5
    },
    "Behsaz": {
      "IsEnabled": true,
      "TimeoutSeconds": 30,
      "RetryCount": 2,
      "CircuitBreaker": {
        "FailureThreshold": 5,
        "OpenDurationSeconds": 30
      }
    }
  }
}
