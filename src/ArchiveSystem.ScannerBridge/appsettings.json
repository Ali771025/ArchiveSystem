{
  "ScannerBridge": {
    "Port": 17891,
    "AllowedOrigins": [
      "http://localhost:5173"
    ],
    "Naps2ConsolePath": "",
    "EnableTwain": true,
    "EnableWia": true,
    "ScanTimeoutSeconds": 300,
    "MaxPagesPerScan": 200,
    "MaxResponseBytes": 104857600,
    "JpegQuality": 85,
    "MaxProcessOutputCharacters": 32768
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
